# --- Public (safe for the browser) ---
# Backend running locally
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
# Backend on Railway
# NEXT_PUBLIC_API_BASE_URL=https://multivendor-ecommerce-backend.up.railway.app

# Optional: shows an "Ask for a quotation on WhatsApp" button on product pages. Country code + number, digits only.
# NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# --- Playwright end-to-end tests (never commit real passwords; .env.local is git-ignored) ---
# These accounts are created by `python seed_mephub.py` in the backend repo.
E2E_ADMIN_EMAIL=admin@mephub.id
E2E_ADMIN_PASSWORD=
E2E_USER_EMAIL=e2e.buyer@mephub.id
E2E_USER_PASSWORD=

# Optional, development only: slow every API call down so loading.tsx is easy to screenshot
# API_DEMO_DELAY_MS=1500
